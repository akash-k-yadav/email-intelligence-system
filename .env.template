# File: .env.template
# ============================================
# Email Intelligence System - Environment Configuration
# ============================================
# Copy this file to .env and fill in your own values.
# See ENV_SETUP.md for full setup instructions.

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# SQLite (default — no setup required)
DATABASE_URL=sqlite:///email_intelligence.db

# --------------------------------------------
# Flask Application Configuration
# --------------------------------------------
# Secret key for session management
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Application port
PORT=5000

# --------------------------------------------
# Email Source Configuration
# --------------------------------------------
# Only 'imap' is implemented in this version
EMAIL_SOURCE=imap

# --------------------------------------------
# IMAP Configuration
# --------------------------------------------
# IMAP server address
IMAP_SERVER=imap.gmail.com

# Your email address
IMAP_USERNAME=your_email_address

# App-specific password (not your regular password)
# For Gmail: https://myaccount.google.com/apppasswords
IMAP_PASSWORD=your_respective_app_passowrd

# IMAP port (993 for SSL)
IMAP_PORT=993

# --------------------------------------------
# Machine Learning Model Thresholds
# --------------------------------------------
# Threshold for phishing classification (0.0 to 1.0)
# Higher = more conservative (fewer false positives)
# Lower = more aggressive (catches more, but more false positives)
PHISHING_THRESHOLD=0.7

# Threshold for spam classification (0.0 to 1.0)
SPAM_THRESHOLD=0.6

# Minimum confidence threshold for predictions
CONFIDENCE_THRESHOLD=0.5

# --------------------------------------------
# Notes
# --------------------------------------------
# - Copy this file to .env and fill in your values
# - Never commit your real .env file to version control
# - Keep credentials secure, rotate if ever exposed
# ============================================
